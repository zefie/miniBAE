1 VERSIONINFO
FILEVERSION     @VERSION_MAJOR@,@VERSION_MINOR@,@VERSION_PATCH@,@VERSION_TWEAK@
PRODUCTVERSION  @VERSION_MAJOR@,@VERSION_MINOR@,@VERSION_PATCH@,@VERSION_TWEAK@
FILEFLAGSMASK   0x3fL
#if _DEBUG == TRUE && GIT_DIRTY == TRUE
FILEFLAGS       0x3L
#elif _DEBUG == TRUE
FILEFLAGS       0x1L
#elif GIT_DIRTY == TRUE
FILEFLAGS       0x2L
#else
FILEFLAGS       0x0L
#endif
FILEOS          0x40004L
FILETYPE        0x2L
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904E4"
        BEGIN
            VALUE "CompanyName", "@PROJECT_COMPANY@"
            VALUE "FileDescription", "@PROJECT_DESCRIPTION@"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "ProductName", "@PROJECT_DESCRIPTION@"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
            VALUE "InternalName", "@ORIGINAL_FILENAME@"
            VALUE "LegalCopyright", "Copyright (C) @VERSION_MINOR@ zefie Networks"
            VALUE "OriginalFilename", "@ORIGINAL_FILENAME@"
            VALUE "GitCommit", "@GIT_COMMIT@"
            VALUE "GitBranch", "@GIT_BRANCH@"
        END
    END

    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04E4
    END
END
