// Example BAEScript: advanced control surface.
// Demonstrates tempo/transpose, channel FX + solo, all-notes-off,
// mixer reverb type, and math builtins.

if (midi.timestamp == 0 && (ch[0].reverb != 48 || ch[1].reverb != 48 || ch[2].reverb != 48 || ch[3].reverb != 48)) {
    mixer.reset();
    mixer.reverbtype = 7;
    midi.tempo = 100;
    midi.transpose = 0;
    for (i = 0; i < 4; i++) {
        ch[i].reverb = 48;
        ch[i].chorus = 32;
        ch[i].solo = 0;
    }
}

// Gentle tempo rise over first 3 seconds (100 -> 120).
if (midi.timestamp < 3000) {
    midi.tempo = clamp(100 + (midi.timestamp * 20 / 3000), 100, 120);
}

// Optional key lift for mid-song section.
if (midi.timestamp >= 3000 && midi.timestamp < 6000) {
    midi.transpose = 2;
} else {
    midi.transpose = 0;
}

// Solo channel 1 briefly, then restore.
if (midi.timestamp >= 2000 && midi.timestamp < 2600) {
    ch[0].solo = 1;
} else {
    ch[0].solo = 0;
}

// Use math helpers with FX send automation.
var sweep = clamp(abs(64 - (midi.timestamp % 128)), 0, 64);
ch[0].reverb = min(127, 32 + sweep);
ch[0].chorus = max(8, 40 - (sweep / 2));

// Safety tail: release all sounding notes near the end.
if (midi.length > 0 && midi.timestamp >= midi.length - 250) {
    midi.allnotesoff();
}
