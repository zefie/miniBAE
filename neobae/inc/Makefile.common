# Nested ifeq from hell!

ifeq ($(BUILD_GUI),1)
	BAE_FLAGS += -D_ZEFI_GUI=1
	SRC	+= src/gui/gui_theme.c \
		src/gui/gui_widgets.c \
		src/gui/gui_text.c \
		src/gui/gui_midi_vkbd.c \
		src/gui/gui_export.c \
		src/gui/gui_dialogs.c \
		src/gui/gui_bae.c \
		src/gui/gui_settings.c \
		src/gui/gui_panels.c \
		src/gui/gui_main.c
	
	# Add debug console for DEBUG builds
	ifeq ($(DEBUG),1)
		SRC += src/gui/gui_debug_console.c
	endif
else
	ifeq ($(RMFINFO),1)
		# libNeoBAE srcs + rmfinfo.c
		SRC += src/rmfinfo/rmfinfo.c
	else
		ifeq ($(INSTDUMP),1)
			# libNeoBAE srcs + instdump.c
			SRC += src/rmfinfo/instdump.c
		else
			ifeq ($(RMF2MID),1)
				# libNeoBAE srcs + rmf2mid.c
				SRC += src/rmf2mid/rmf2mid.c
			else
				ifeq ($(MID2RMF),1)
					# libNeoBAE srcs + mid2rmf.c
					SRC += src/mid2rmf/mid2rmf.c
				else
					ifeq ($(MID2RMI),1)
						# libNeoBAE srcs + mid2rmi.c
						SRC += src/mid2rmi/mid2rmi.c
					else
						ifeq ($(MOD2RMF_APP),1)
							SRC += src/mod2rmf/mod2rmf_main.c
						else
							ifeq ($(BANKRECOMP),1)
								# libNeoBAE srcs + bankrecomp_api.c
								SRC += src/bankrecomp/bankrecomp_api.c
							else
								ifeq ($(SF2_TO_HSB),1)
									# libNeoBAE srcs + sf2-hsb
									SRC += src/sf2-hsb/sf2_hsb_converter.c \
										src/mod2rmf/mod2rmf_encoder.c \
										src/sf2-hsb/sf2_parser.c \
										src/sf2-hsb/hsb_writer.c \
										src/sf2-hsb/sf2_hsb_main.c
									BAE_FLAGS += -Isrc/mod2rmf
								else							
									ifeq ($(NBSTUDIO),1)
										SRC += 	src/nbstudio/editor_main.cpp \
											src/nbstudio/editor_bank.cpp \
											src/nbstudio/editor_instrument_ext_dialog.cpp \
											src/nbstudio/editor_metadata_dialog.cpp \
											src/nbstudio/editor_pianoroll_panel.cpp \
											src/nbstudio/batch_compress_dialog.cpp
										ifneq ($(MACOSX),1)
											BAE_FLAGS += $(shell pkg-config --cflags gtk+-3.0) $(shell pkg-config --cflags glib-2.0)
											BAE_LIBS += -lz $(shell pkg-config --libs gtk+-3.0) $(shell pkg-config --libs glib-2.0)
										endif
									else
										ifeq ($(NBEDITOR),1)
											SRC += src/nbeditor/nbeditor_main.cpp \
												src/thirdparty/imgui/imgui.cpp \
												src/thirdparty/imgui/imgui_draw.cpp \
												src/thirdparty/imgui/imgui_tables.cpp \
												src/thirdparty/imgui/imgui_widgets.cpp \
												src/thirdparty/imgui/backends/imgui_impl_sdl3.cpp \
												src/thirdparty/imgui/backends/imgui_impl_sdlrenderer3.cpp
											INC_PATH += -Isrc/thirdparty/imgui -Isrc/thirdparty/imgui/backends
										else
											ifeq ($(ADP2WAV),1)
												# adp2wav with third-party G.722 decoder
												SRC := src/adp2wav/adp2wav_main.c src/adp2wav/adp2wav_decode.c src/thirdparty/libg722/g722_decode.c
											else
												ifeq ($(MIDDECOMP),1)
													SRC := src/mthc/mthc_decomp.c src/mthc/mthc_main.c
												else
													ifeq ($(RAYLIB_EXAMPLE),1)
														SRC += src/raylib_example/audio_stream_callback.c
														BAE_LIBS += -lraylib -lm
													else
														ifneq ($(WASM),1)
															ifneq ($(SONGTOOL),1)
																	ifeq ($(RINGTONE2MID),1)
																		# libNeoBAE srcs + ringtone2mid.c
																		SRC += src/ringtone2mid/ringtone2mid.c
																	else
																		ifeq ($(NEOBAE_TUI),1)
																			# neobae-tui = libNeoBAE srcs + neobae_tui.c
																			SRC += src/playbae/neobae_tui.c
																		else
																			# playbae = libNeoBAE srcs + playbae.c
																			SRC += src/playbae/playbae.c
																		endif
																	endif
																else
																	# libNeoBAE srcs + songtool.c
																	SRC += src/songtool/songtool.c
																endif
															endif
														endif
													endif
												endif
											endif
										endif
									endif
								endif
							endif
						endif
					endif
				endif
			endif
		endif
	endif

ifeq ($(MTHC_SUPPORT),1)
	ifneq ($(MIDDECOMP),1)
		ifneq ($(ADP2WAV),1)
			SRC += src/mthc/mthc_decomp.c
			BAE_FLAGS += -DUSE_MTHC_SUPPORT=1
		endif
	endif
endif

ifeq ($(ADP_SUPPORT),1)
	ifneq ($(ADP2WAV),1)
		SRC += src/adp2wav/adp2wav_decode.c \
			src/thirdparty/libg722/g722_decode.c
		BAE_FLAGS += -DUSE_ADP_SUPPORT=1
	endif
endif


ifeq ($(QOA_SUPPORT),1)
	BAE_FLAGS += -DUSE_QOA_SUPPORT=1
	INC_PATH += -Isrc/thirdparty/qoa
	SRC += src/BAE_Source/Common/XQOAFiles.c
endif

ifeq ($(KARAOKE),1)
	ifneq ($(BUILD_GUI),)
		SRC += src/gui/gui_karaoke.c
	endif
endif

ifeq ($(ENABLE_MIDI_HW),1)
	ifneq ($(BUILD_GUI),)
		# RtMidi (C wrapper) - provide real-time MIDI input for GUI
		BAE_FLAGS += -DSUPPORT_MIDI_HW=1
		SRC +=  src/gui/gui_midi_hw.c \
			src/gui/gui_midi_hw_input.c \
			src/gui/gui_midi_hw_output.c \
			src/thirdparty/rtmidi/rtmidi_c.cpp \
			src/thirdparty/rtmidi/RtMidi.cpp
	endif
endif

ifeq ($(PLAYLIST),1)
	ifneq ($(BUILD_GUI),)
		BAE_FLAGS += -DSUPPORT_PLAYLIST=1
		SRC +=  src/gui/gui_playlist.c
	endif
endif


ifeq ($(LOGFILE),1)
	BAE_FLAGS += -DOUTPUT_TO_LOGFILE=1
endif

ifeq ($(WINDOWS),1)
	ifneq ($(filter 1,$(FLAC_DEC) $(FLAC_ENC)),)
		INC_PATH += -Isrc/thirdparty/flac/src/share/win_utf8_io
		BAE_FLAGS += -DFLAC__NO_DLL
		SRC += src/thirdparty/flac/src/share/win_utf8_io/win_utf8_io.c
	endif
endif

ifeq ($(KARAOKE),1)
	BAE_FLAGS += -DSUPPORT_KARAOKE=1
endif

ifeq ($(BAESCRIPT),1)
	BAE_FLAGS += -DSUPPORT_BAESCRIPT=1
	INC_PATH += -Isrc/script
	SRC += src/script/baescript.c \
		src/script/baescript_lexer.c \
		src/script/baescript_parser.c \
		src/script/baescript_vm.c
	ifneq ($(BUILD_GUI),)
		SRC += src/gui/gui_script_editor.c
	endif
endif

OBJ_DIR 	:= $(BUILD_DIR)obj/
# Create unique object names for conflicting basenames across third-party trees.
define uniq_obj_src
$(subst src/thirdparty/opus/celt/mdct.c,src/thirdparty/opus/celt/opus_mdct.c,$(subst src/thirdparty/flac/src/libFLAC/lpc.c,src/thirdparty/flac/src/libFLAC/flac_lpc.c,$(subst src/thirdparty/flac/src/libFLAC/window.c,src/thirdparty/flac/src/libFLAC/flac_window.c,$(subst src/thirdparty/libvorbis/lib/lpc.c,src/thirdparty/libvorbis/lib/vorbis_lpc.c,$(subst src/thirdparty/libvorbis/lib/window.c,src/thirdparty/libvorbis/lib/vorbis_window.c,$(subst src/thirdparty/opus/src/analysis.c,src/thirdparty/opus/src/opus_analysis.c,$(subst src/thirdparty/opusfile/src/info.c,src/thirdparty/opusfile/src/opusfile_info.c,$(subst src/thirdparty/opusfile/src/stream.c,src/thirdparty/opusfile/src/opusfile_stream.c,$(1)))))))))
endef

define obj_name_from_src
$(notdir $(basename $(call uniq_obj_src,$(1))))
endef

SRC_UNIQUE := $(foreach s,$(SRC),$(call uniq_obj_src,$(s)))
SRC_BIN_UNIQUE := $(foreach s,$(SRC),$(call uniq_obj_src,$(s)))
OBJ_BIN 	:= $(addprefix $(OBJ_DIR),$(addsuffix .o,$(notdir $(basename $(SRC_BIN_UNIQUE)))))

ifeq ($(BUILD_GUI),1)

BAE_FLAGS += -D_ZEFI_GUI=1

# If EMBED_TTF_FONT specified, generate embedded_font.h and define EMBED_TTF_FONT
ifeq ($(EMBED_FONT),1)
ifdef EMBED_TTF_FONT
BAE_FLAGS += -DEMBED_TTF_FONT -I$(OBJ_DIR)

EMBED_FONT_HEADER := $(OBJ_DIR)embedded_font.h
$(EMBED_FONT_HEADER): $(EMBED_TTF_FONT) ../scripts/create_embedded_font_h.py
	@echo @embed $<
	@mkdir -p $(dir $(EMBED_FONT_HEADER))
	@python3 ../scripts/create_embedded_font_h.py $(EMBED_TTF_FONT) $(EMBED_FONT_HEADER)

$(OBJ_DIR)gui_main.o: $(EMBED_FONT_HEADER)
endif # EMBED_FONT_HEADER
endif # EMBED_FONT

endif # BUILD_GUI

# If EMBED_PATCH_FILE specified, generate BAEPatches.h that embeds the binary bank
ifeq ($(EMBED_PATCHES),1)
ifdef EMBED_PATCH_FILE
BAE_FLAGS += -D_BUILT_IN_PATCHES=1 -I$(OBJ_DIR)

EMBED_PATCH_HEADER := $(OBJ_DIR)BAEPatches.h
$(EMBED_PATCH_HEADER): $(EMBED_PATCH_FILE) ../scripts/create_embedded_patches_h.py
	@echo @embed $<
	@mkdir -p $(dir $(EMBED_PATCH_HEADER))
	@python3 ../scripts/create_embedded_patches_h.py $(EMBED_PATCH_FILE) $(EMBED_PATCH_HEADER)
$(OBJ_DIR)NeoBAE.o: $(EMBED_PATCH_HEADER)

ifeq ($(USE_BUILTIN_PATCHES_WITH_SF2),1)
BAE_FLAGS += -D_LOAD_BUILTIN_PATCHES_FOR_SF2=1
endif # USE_BUILTIN_PATCHES_WITH_SF2

ifeq ($(USE_BUILTIN_PATCHES_WITH_DLS),1)
BAE_FLAGS += -D_LOAD_BUILTIN_PATCHES_FOR_DLS=1
endif # USE_BUILTIN_PATCHES_WITH_DLS

endif # EMBED_PATCH_FILE
endif # EMBED_PATCHES

# Rules for compiling source files to object files
# Create a function to map source files to object files with unique names for conflicts
define make_obj_rule
$(OBJ_DIR)$(call obj_name_from_src,$(1)).o: $(1)
	@echo @compile $$<
	@mkdir -p $(OBJ_DIR)
	$(SILENT)$(if $(filter %.cpp,$(1)),${CXX} -c ${CXXFLAGS},${CC} -c ${CFLAGS}) $$< -o $$@
endef

ifeq ($(USE_SDL3),1)
	BAE_FLAGS += -D_USING_SDL3=1
endif
ifeq ($(USE_RAYLIB),1)
	BAE_FLAGS += -D_USING_RAYLIB=1
endif
#### End Makefile.common
