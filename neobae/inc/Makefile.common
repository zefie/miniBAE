# Built-in Patches (affects entire NeoBAE library)
# Must be an HSB bank, leave empty to disable built-in patches completely
EMBED_PATCH_FILE ?= src/banks/patches111/patches111.hsb

# TTF Font (for zefidi GUI)
# Not required but severely recommended
EMBED_TTF_FONT ?= src/thirdparty/fonts/HelveticaNeue.ttf

### It is probably best not to change anything below this line, unless absolutely necessary for your environment

BUILD_DIR	  := build/
TEST_OUT_DIR  := tests/
TARGET_OUT	  := bin/
BAE_FLAGS	  :=
BAE_LD_FLAGS  := -Wl,-rpath,'$$ORIGIN'
BAE_LIBS      :=
.DEFAULT_GOAL := all
LZMA_VERS := 5.8.3

# Default build options (override with NOAUTO=1)
ifneq ($(WASM),1)
	ifneq ($(NOAUTO),1)
		ZMF_SUPPORT := 1
		KARAOKE := 1
		BAESCRIPT := 1
		PLAYLIST := 1
		SF2_SUPPORT := 1
		USE_FLUIDSYNTH := 1
		EMBED_PATCHES := 1
		EMBED_FONT := 1
		XMF_SUPPORT := 1
		RMI_SUPPORT := 1
		RETRO_RINGTONE_SUPPORT := 1
		DISABLE_NOKIA := 0			    
		DISABLE_BEATNIK_SF2_NRPN := 0
		USE_BUILTIN_PATCHES_WITH_SF2 := 1
		USE_BUILTIN_PATCHES_WITH_DLS := 1
		FIX_SPAN_DC := 1
		CLASSIC_CHORUS := 1
		LZMA_SUPPORT := 1
		MTHC_SUPPORT := 1
		ADP_SUPPORT := 1
		QOA_SUPPORT := 1
		MP3_DEC := 1
		MP3_ENC := 1
		FLAC_DEC := 1
		FLAC_ENC := 1
		VORBIS_DEC := 1
		VORBIS_ENC := 1
		OPUS_DEC := 1
		OPUS_ENC := 1
		J2ME_PATCH := 1
		CREATION_NO_CODECS := 0
		CREATION_API := 0
		UNROLL_MIDI :=1
		ADX_SUPPORT := 1
		NATIVE_DLS := 1
	endif
endif

ifeq ($(NBSTUDIO),1)
	# NBStudio requires ZMF support
	# and the creation API
	ZMF_SUPPORT := 1
	CREATION_API := 1
	FIX_SPAN_DC := 1
	CLASSIC_CHORUS := 1
endif

ifeq ($(NBEDITOR),1)
	# NBEditor requires ZMF support
	# and the creation API
	ZMF_SUPPORT := 1
	CREATION_API := 1
	FIX_SPAN_DC := 1
	CLASSIC_CHORUS := 1
	BAE_FLAGS += -DNBEDITOR=1 -DNBEDITOR_MVP=1 -DNBEDITOR_PLAYER_WINDOW=1 -DNBEDITOR_SAMPLE_LIST_WINDOW=1 -DNBEDITOR_INSTRUMENT_LIST_WINDOW=1
	INC_PATH += -Isrc/thirdparty/imgui -Isrc/thirdparty/imgui/backends
endif

ifeq ($(CREATION_API),1) 
	# All of these are required for ZMF support
	ifneq ($(CREATION_NO_CODECS),1)
		OGG_SUPPORT := 1
		MP3_DEC := 1
		MP3_ENC := 1
		FLAC_DEC := 1
		FLAC_ENC := 1
		VORBIS_DEC := 1
		VORBIS_ENC := 1
		OPUS_DEC := 1
		OPUS_ENC := 1
		QOA_SUPPORT := 1
	endif
	ZMF_SUPPORT := 1
endif

ifeq ($(ZMF_SUPPORT),1)
	LZMA_SUPPORT := 1
	FIX_SPAN_DC := 1
	CLASSIC_CHORUS := 1
endif	

# Disable SDL2 if using SDL3
ifeq ($(USE_SDL3),1)
	USE_SDL2 := 0
endif

# Disable SDL backends if using raylib
ifeq ($(USE_RAYLIB),1)
	USE_SDL2 := 0
	USE_SDL3 := 0
endif

# Likewise, Disable SDL3 if using SDL2
ifeq ($(USE_SDL2),1)
	USE_SDL3 := 0
endif

# Enable SoundFont (SF2) support via FluidSynth overlay. Set this to TRUE to enable.
ifeq ($(SF2_SUPPORT),1)
	USE_FLUIDSYNTH := 1
endif

# Native DLS is required for XMF
ifneq ($(NATIVE_DLS),1)
   XMF_SUPPORT := 0
endif


# Force OGG support if VORBIS is chosen
ifneq ($(OGG_SUPPORT),1)
	ifneq ($(filter 1,$(VORBIS_ENC) $(VORBIS_DEC) $(FLAC_DEC) $(FLAC_ENC) $(OPUS_DEC) $(OPUS_ENC)),) 
		OGG_SUPPORT := 1
	endif
endif

ifneq ($(filter 1,$(VERBOSE) $(V)),)
	SILENT :=
else
	SILENT := @
endif

# Begin Allow Overrides
ifeq ($(TARGET_LIB),)
	TARGET_LIB	:= libNeoBAE
endif

ifeq ($(TARGET_BIN),)
	ifneq ($(BUILD_GUI),) 
		TARGET_BIN	:= zefidi
		TARGET_NAME := $(TARGET_BIN)
	else
		TARGET_BIN	:= playbae
		TARGET_NAME := $(TARGET_BIN)
	endif
else
	TARGET_NAME := $(TARGET_BIN)	
endif

ifeq ($(TEST_BIN_PREFIX),)
	TEST_BIN	:= $(TARGET_OUT)$(TARGET_BIN)
else
	TEST_BIN	:= $(TEST_BIN_PREFIX)$(TARGET_OUT)$(TARGET_BIN)
endif
# End Allow Overrides

INC_PATH	:= -Isrc/BAE_Source/Common
INC_PATH	+= -Isrc/BAE_Source/Platform
INC_PATH	+= -Isrc/thirdparty/config

ifneq ($(filter 1,$(MP3_ENC) $(MP3_DEC)),) 
	INC_PATH  += -Isrc/BAE_MPEG_Source_II
endif

ifeq ($(MP3_DEC),1)
	INC_PATH	+= -Isrc/thirdparty/minimp3
endif

ifeq ($(ENABLE_MIDI_HW),1)
	INC_PATH	+= -Isrc/thirdparty/rtmidi
endif

ifeq ($(DISABLE_NOKIA),1)
	BAE_FLAGS += -DDISABLE_NOKIA_PATCH=1
endif

ifeq ($(DISABLE_BEATNIK_SF2_NRPN),1)
	BAE_FLAGS += -DISABLE_BEATNIK_SF2_NRPN=1
endif

ifeq ($(FIX_SPAN_DC),1)
	BAE_FLAGS += -DBAE_FIX_SPAN_DC=1
endif

ifeq ($(CLASSIC_CHORUS),1)
	BAE_FLAGS += -DBAE_CLASSIC_CHORUS=1
endif

ifeq ($(ZMF_SUPPORT),1)
	BAE_FLAGS += -DUSE_ZMF_SUPPORT=1
endif

ifeq ($(RMI_SUPPORT),1)
	BAE_FLAGS += -DUSE_RMI_SUPPORT=1
endif

ifeq ($(J2ME_PATCH),1)
	BAE_FLAGS += -DUSE_J2ME_PATCH=1
endif

ifeq ($(RETRO_RINGTONE_SUPPORT),1)
	BAE_FLAGS += -DUSE_RETRO_RINGTONE_SUPPORT=1
endif

ifeq ($(UNROLL_MIDI),1)
	BAE_FLAGS += -DBAE_ENABLE_ROLLED_MIDI_UNROLL=1
endif

ifneq ($(filter 1,$(FLAC_ENC) $(FLAC_DEC)),) 
	INC_PATH	+= -Isrc/thirdparty/flac/include -Isrc/thirdparty/flac/src/libFLAC/include -Isrc/thirdparty/flac/src
	BAE_FLAGS += -DHAVE_CONFIG_H=1 -DHAVE_STDINT_H=1 -DHAVE_INTTYPES_H=1 -DSIZE_T_MAX=SIZE_MAX
	ifeq ($(OGG_SUPPORT),1)
		BAE_FLAGS += -DFLAC__HAS_OGG=1
	else
		BAE_FLAGS += -DFLAC__HAS_OGG=0
	endif
endif

ifeq ($(WINDOWS),1)
	ifeq ($(BITS),32)
		INC_PATH += -I/mingw32/include -I/usr/i686-w64-mingw32/include
		BAE_LIBS += -L/mingw32/lib -L/usr/i686-w64-mingw32/lib
	else
		INC_PATH += -I/mingw64/include -I/usr/x86_64-w64-mingw32/include
		BAE_LIBS += -L/mingw64/lib -L/usr/x86_64-w64-mingw32/lib
	endif
endif

ifneq ($(filter 1,$(OPUS_DEC) $(OPUS_ENC)),)
	INC_PATH	+= -Isrc/thirdparty/opus/include
	INC_PATH	+= -Isrc/thirdparty/opus/celt
	INC_PATH	+= -Isrc/thirdparty/opus/silk
	INC_PATH	+= -Isrc/thirdparty/opus/silk/float
	INC_PATH	+= -Isrc/thirdparty/opus/src
	ifeq ($(OPUS_DEC),1)
		INC_PATH	+= -Isrc/thirdparty/opusfile/include
		INC_PATH	+= -Isrc/thirdparty/opusfile/src
	endif
	BAE_FLAGS += -DVAR_ARRAYS=1 -DOPUS_BUILD=1
	ifeq ($(OPUS_DEC),1)
		BAE_FLAGS += -DUSE_OPUS_DECODER=1
	endif
	ifeq ($(OPUS_ENC),1)
		BAE_FLAGS += -DUSE_OPUS_ENCODER=1
	endif
endif

ifneq ($(filter 1,$(VORBIS_DEC) $(VORBIS_ENC)),) 
	INC_PATH	+= -Isrc/thirdparty/libvorbis/include -Isrc/thirdparty/libvorbis/lib
endif

# default to ANSI
ifeq ($(BAE_API),)
	BAE_API		:= Dummy
endif

## Begin Easy API -> X_PLATFORM
# Supported APIs
ifeq ($(BAE_API),Ansi)
	# No audio output
	BAE_FLAGS += 	-DX_PLATFORM=X_ANSI
	SRC       :=	src/BAE_Source/Platform/BAE_API_$(BAE_API).c
endif
ifeq ($(BAE_API),Dummy)
	# No audio output, no pthreads
	BAE_FLAGS += 	-DX_PLATFORM=X_DUMMY
	SRC       :=	src/BAE_Source/Platform/BAE_API_$(BAE_API).c
endif
ifeq ($(BAE_API),WASM)
	BAE_FLAGS += 	-DX_PLATFORM=X_WASM
	SRC       :=	src/BAE_Source/Platform/BAE_API_$(BAE_API).c \
					src/BAE_Source/Platform/BAE_API_WASM_Export.c
endif
ifeq ($(BAE_API),WinOS)
	BAE_FLAGS += 	-DX_PLATFORM=X_WIN95
	SRC       :=	src/BAE_Source/Platform/BAE_API_$(BAE_API).c \
			src/BAE_Source/Platform/BAE_API_$(BAE_API)_Capture.c \
			src/BAE_Source/Platform/BAE_API_$(BAE_API)_Thread.c
endif
ifeq ($(BAE_API),SDL2)
	BAE_FLAGS += 	-DX_PLATFORM=X_SDL2 -DUSE_SDL2=1
	SRC       :=	src/BAE_Source/Platform/BAE_API_$(BAE_API).c
endif
ifeq ($(BAE_API),SDL3)
	BAE_FLAGS += 	-DX_PLATFORM=X_SDL3
	SRC       :=	src/BAE_Source/Platform/BAE_API_$(BAE_API).c
endif
ifeq ($(BAE_API),Raylib)
	BAE_FLAGS += 	-DX_PLATFORM=X_RAYLIB -DUSE_RAYLIB=1
	SRC       :=	src/BAE_Source/Platform/BAE_API_$(BAE_API).c
endif
ifeq ($(BAE_API),Android)
	BAE_FLAGS += 	-DX_PLATFORM=X_ANDROID
	SRC       :=	src/BAE_Source/Platform/BAE_API_$(BAE_API).c
endif
# zefie has not tested these APIs
ifeq ($(BAE_API),foobar2000)
	BAE_FLAGS += 	-DX_PLATFORM=X_FOOBAR2000_PLUGIN
	SRC       :=	src/BAE_Source/Platform/BAE_API_$(BAE_API).c
endif
ifeq ($(BAE_API),MacOSX)
	BAE_FLAGS += 	-DX_PLATFORM=X_MACINTOSH
	SRC       :=	src/BAE_Source/Platform/BAE_API_$(BAE_API).c
endif
ifeq ($(BAE_API),IOS)
	BAE_FLAGS += 	-DX_PLATFORM=X_IOS
	SRC       :=	src/BAE_Source/Platform/BAE_API_$(BAE_API).c
endif
## End Easy API -> X_PLATFORM
### End configure BAE API

# Debug
ifeq ($(DEBUG),1)
	BAE_FLAGS +=    -D_DEBUG=1 -Wall -Wno-unused-function
endif


ifeq ($(SF2_SUPPORT),1)
	BAE_FLAGS += -DUSE_SF2_SUPPORT=1
endif

ifeq ($(XMF_SUPPORT),1)
	BAE_FLAGS += -DUSE_XMF_SUPPORT=1
	SRC += src/BAE_Source/Common/GenXMF.c
	BAE_LIBS += -lz
endif


# Primary libNeoBAE sources
SRC		+=	src/BAE_Source/Common/DriverTools.c \
			src/BAE_Source/Common/GenAudioStreams.c \
			src/BAE_Source/Common/GenCache.c \
			src/BAE_Source/Common/GenChorus.c \
			src/BAE_Source/Common/GenFiltersReverbU3232.c \
			src/BAE_Source/Common/GenInterp2ReverbU3232.c \
			src/BAE_Source/Common/GenOutput.c \
			src/BAE_Source/Common/GenPatch.c \
			src/BAE_Source/Common/GenReverb.c \
			src/BAE_Source/Common/GenReverbNew.c \
			src/BAE_Source/Common/GenReverbNeo.c \
			src/BAE_Source/Common/GenSample.c \
			src/BAE_Source/Common/GenSeq.c \
			src/BAE_Source/Common/GenSeqTools.c \
			src/BAE_Source/Common/GenSetup.c \
			src/BAE_Source/Common/GenSong.c \
			src/BAE_Source/Common/GenSoundFiles.c \
			src/BAE_Source/Common/GenSynth.c \
			src/BAE_Source/Common/GenSynthFiltersSimple.c \
			src/BAE_Source/Common/GenSynthFiltersU3232.c \
			src/BAE_Source/Common/GenSynthInterp2Simple.c \
			src/BAE_Source/Common/GenSynthInterp2U3232.c \
			src/BAE_Source/Common/NeoBAE.c \
			src/BAE_Source/Common/NewNewLZSS.c \
			src/BAE_Source/Common/SampleTools.c \
			src/BAE_Source/Common/X_API.c \
			src/BAE_Source/Common/X_Decompress.c \
			src/BAE_Source/Common/X_IMA.c \
			src/BAE_Source/Common/g711.c \
			src/BAE_Source/Common/g721.c \
			src/BAE_Source/Common/g723_24.c \
			src/BAE_Source/Common/g723_40.c \
			src/BAE_Source/Common/g72x.c \
			src/BAE_Source/Common/BAE_Override.c \
			src/BAE_Source/Common/sha1mini.c \
			src/BAE_Source/Common/XFileTypes.c \
			src/BAE_Source/Common/X_DebugCallback.c

ifeq ($(RETRO_RINGTONE_SUPPORT),1)
	SRC += src/BAE_Source/Common/GenRingtone.c
endif

ifeq ($(ADX_SUPPORT),1)
	SRC += src/BAE_Source/Common/XADXFiles.c
	BAE_FLAGS += -DUSE_ADX_SUPPORT=1
endif

ifeq ($(NATIVE_DLS),1)
	SRC += src/BAE_Source/Common/GenDLS_MobileBAE.c
	BAE_FLAGS += -DUSE_NATIVE_DLS=1
endif

ifeq ($(RMI_SUPPORT),1)
	SRC += src/BAE_Source/Common/GenRMI.c
endif

ifeq ($(SF2_SUPPORT),1)
	ifeq ($(USE_FLUIDSYNTH),1)
		SRC += src/BAE_Source/Common/GenSF2_FluidSynth.c
		BAE_FLAGS += -D_USING_FLUIDSYNTH=1 
		ifeq ($(WINDOWS),1)					
			ifeq ($(BITS),32)
				INC_PATH += -I../deps/win/FluidSynth/i686-w64-mingw32/include
				BAE_LD_FLAGS += -L../deps/win/FluidSynth/i686-w64-mingw32/lib/
				BAE_LIBS += ../deps/win/FluidSynth/i686-w64-mingw32/lib/libfluidsynth-3.dll.a -Wl,-rpath,'$$ORIGIN'
			else
				INC_PATH += -I../deps/win/FluidSynth/x86_64-w64-mingw32/include
				BAE_LD_FLAGS += -L../deps/win/FluidSynth/x86_64-w64-mingw32/lib/
				BAE_LIBS += ../deps/win/FluidSynth/x86_64-w64-mingw32/lib/libfluidsynth-3.dll.a -Wl,-rpath,'$$ORIGIN'
			endif			
		else
			ifneq ($(XPHACK),1)
				ifneq ($(WASM),1)
					# System FluidSynth for Linux (dynamic) if pkg-config available
					FLUIDSYNTH_CFLAGS := $(shell pkg-config --cflags fluidsynth 2>/dev/null)
					FLUIDSYNTH_LIBS   := $(shell pkg-config --libs fluidsynth 2>/dev/null)
					ifneq ($(FLUIDSYNTH_LIBS),)
						BAE_FLAGS += $(FLUIDSYNTH_CFLAGS)
						# Prepend pkg-config libs; they already have -lfluidsynth and any needed deps
						BAE_LIBS := $(FLUIDSYNTH_LIBS) $(filter-out -lfluidsynth,$(BAE_LIBS))
						ifneq (,$(findstring -static,$(ARCH)))
							ARCH := $(filter-out -static,$(ARCH))
							LDFLAGS := $(filter-out -static,$(LDFLAGS))
						endif
					else
						# Fallback minimal guess
						BAE_FLAGS += -I/usr/include/fluidsynth
						BAE_LIBS += -lfluidsynth $(BAE_LIBS)
					endif
				endif
			endif
		endif
	endif
endif
ifneq ($(WINDOWS),1)
	ifeq ($(USE_SDL2),1)
		SDL_CFLAGS := $(shell pkg-config --cflags SDL2 2>/dev/null)
		SDL_LIBS   := $(shell pkg-config --libs SDL2 2>/dev/null)
		ifneq ($(SDL_LIBS),)
			BAE_FLAGS += $(SDL_CFLAGS)
			# Prepend pkg-config libs; they already have -lfluidsynth and any needed deps
			BAE_LIBS := $(SDL_LIBS) $(filter-out -lSDL2,$(BAE_LIBS))
			ifneq (,$(findstring -static,$(ARCH)))
				ARCH := $(filter-out -static,$(ARCH))
				LDFLAGS := $(filter-out -static,$(LDFLAGS))
			endif
		else
			# Fallback minimal guess
			BAE_FLAGS += -I/usr/include/SDL2
			BAE_LIBS += -lSDL2 $(BAE_LIBS)
		endif
	endif

	ifeq ($(USE_SDL3),1)
		SDL_CFLAGS := $(shell pkg-config --cflags SDL3 2>/dev/null)
		SDL_LIBS   := $(shell pkg-config --libs SDL3 2>/dev/null)
		ifneq ($(SDL_LIBS),)
			BAE_FLAGS += $(SDL_CFLAGS)
			# Prepend pkg-config libs; they already have -lfluidsynth and any needed deps
			BAE_LIBS := $(SDL_LIBS) $(filter-out -lSDL3,$(BAE_LIBS))
			ifneq (,$(findstring -static,$(ARCH)))
				ARCH := $(filter-out -static,$(ARCH))
				LDFLAGS := $(filter-out -static,$(LDFLAGS))
			endif
		else
			# Fallback minimal guess
			BAE_FLAGS += -I/usr/include/SDL2
			BAE_LIBS += -lSDL3 $(BAE_LIBS)
		endif
	endif
endif

ifeq ($(MP3_DEC),1)
	# Enable minimp3 wrapper for MPG_* API (decoder only)
	BAE_FLAGS += -DUSE_MINIMP3_WRAPPER=1 -DUSE_MPEG_DECODER=1
	SRC += src/BAE_MPEG_Source_II/XMPEG_minimp3_wrapper.c
endif

# Include XMPEGFilesSun.c when either encoder or decoder is enabled
ifneq ($(filter 1,$(MP3_ENC) $(MP3_DEC)),) 
	SRC += src/BAE_MPEG_Source_II/XMPEGFilesSun.c
endif

# RMF editing and creation API, used by NeoBAE Studio
# This API enables numerous exports in the DLL and LIB
# for interacting with the BAE system
ifeq ($(CREATION_API),1)
	SRC += src/BAE_Source/Common/BAERmfEditor.c
endif

# Optional MP3 encoder integration
# Enable with make MP3_ENC=1 (or set in environment)
ifeq ($(MP3_ENC),1)
	INC_PATH += -Isrc/thirdparty/lame-3.100-slim/include
	INC_PATH += -Isrc/thirdparty/lame-3.100-slim/libmp3lame
	INC_PATH += -Isrc/thirdparty/lame-3.100-slim/mpglib
	BAE_FLAGS += -DHAVE_CONFIG_H=1 -DHAVE_STDINT_H=1 -DHAVE_INTTYPES_H=1
	BAE_FLAGS += -DUSE_MPEG_ENCODER=1 -DUSE_LAME_ENCODER=1
	SRC += src/BAE_MPEG_Source_II/XMPEG_lame_encoder.cpp
	SRC += src/thirdparty/lame-3.100-slim/libmp3lame/VbrTag.c
	SRC += src/thirdparty/lame-3.100-slim/libmp3lame/bitstream.c
	SRC += src/thirdparty/lame-3.100-slim/libmp3lame/encoder.c
	SRC += src/thirdparty/lame-3.100-slim/libmp3lame/fft.c
	SRC += src/thirdparty/lame-3.100-slim/libmp3lame/gain_analysis.c
	SRC += src/thirdparty/lame-3.100-slim/libmp3lame/id3tag.c
	SRC += src/thirdparty/lame-3.100-slim/libmp3lame/lame.c
	SRC += src/thirdparty/lame-3.100-slim/libmp3lame/newmdct.c
	SRC += src/thirdparty/lame-3.100-slim/libmp3lame/presets.c
	SRC += src/thirdparty/lame-3.100-slim/libmp3lame/psymodel.c
	SRC += src/thirdparty/lame-3.100-slim/libmp3lame/quantize.c
	SRC += src/thirdparty/lame-3.100-slim/libmp3lame/quantize_pvt.c
	SRC += src/thirdparty/lame-3.100-slim/libmp3lame/reservoir.c
	SRC += src/thirdparty/lame-3.100-slim/libmp3lame/set_get.c
	SRC += src/thirdparty/lame-3.100-slim/libmp3lame/tables.c
	SRC += src/thirdparty/lame-3.100-slim/libmp3lame/takehiro.c
	SRC += src/thirdparty/lame-3.100-slim/libmp3lame/util.c
	SRC += src/thirdparty/lame-3.100-slim/libmp3lame/vbrquantize.c
	SRC += src/thirdparty/lame-3.100-slim/libmp3lame/version.c
	SRC += src/thirdparty/lame-3.100-slim/libmp3lame/mpglib_interface.c
endif

# Add FLAC decoder source files
ifneq ($(filter 1,$(FLAC_DEC) $(FLAC_ENC)),)
	SRC += src/thirdparty/flac/src/libFLAC/stream_encoder.c
	SRC += src/thirdparty/flac/src/libFLAC/bitmath.c
	SRC += src/thirdparty/flac/src/libFLAC/bitreader.c
	SRC += src/thirdparty/flac/src/libFLAC/bitwriter.c
	SRC += src/thirdparty/flac/src/libFLAC/cpu.c
	SRC += src/thirdparty/flac/src/libFLAC/crc.c
	SRC += src/thirdparty/flac/src/libFLAC/fixed.c
	SRC += src/thirdparty/flac/src/libFLAC/float.c
	SRC += src/thirdparty/flac/src/libFLAC/format.c
	SRC += src/thirdparty/flac/src/libFLAC/lpc.c
	SRC += src/thirdparty/flac/src/libFLAC/md5.c
	SRC += src/thirdparty/flac/src/libFLAC/memory.c
	SRC += src/thirdparty/flac/src/libFLAC/metadata_iterators.c
	SRC += src/thirdparty/flac/src/libFLAC/metadata_object.c
	SRC += src/thirdparty/flac/src/libFLAC/stream_decoder.c
	SRC += src/thirdparty/flac/src/libFLAC/stream_encoder_framing.c
	SRC += src/thirdparty/flac/src/libFLAC/window.c
	ifeq ($(OGG_SUPPORT),1)
		SRC += src/thirdparty/flac/src/libFLAC/ogg_decoder_aspect.c
		SRC += src/thirdparty/flac/src/libFLAC/ogg_encoder_aspect.c
		SRC += src/thirdparty/flac/src/libFLAC/ogg_helper.c
		SRC += src/thirdparty/flac/src/libFLAC/ogg_mapping.c
	endif
endif

# Add FLAC decoder source files
ifeq ($(FLAC_DEC),1)
	BAE_FLAGS += -DUSE_FLAC_DECODER=1
endif

# Add FLAC encoder source files
ifeq ($(FLAC_ENC),1)
	BAE_FLAGS += -DUSE_FLAC_ENCODER=1
endif

# Add libogg source files
ifeq ($(OGG_SUPPORT),1)
	SRC += src/thirdparty/libogg/src/bitwise.c
	SRC += src/thirdparty/libogg/src/framing.c
	BAE_FLAGS += -DUSE_OGG_FORMAT=1
endif

# Add libvorbis decoder source files
ifneq ($(filter 1,$(VORBIS_DEC) $(VORBIS_ENC)),) 
	SRC += src/thirdparty/libvorbis/lib/mdct.c
	SRC += src/thirdparty/libvorbis/lib/smallft.c
	SRC += src/thirdparty/libvorbis/lib/block.c
	SRC += src/thirdparty/libvorbis/lib/envelope.c
	SRC += src/thirdparty/libvorbis/lib/window.c
	SRC += src/thirdparty/libvorbis/lib/lsp.c
	SRC += src/thirdparty/libvorbis/lib/lpc.c
	SRC += src/thirdparty/libvorbis/lib/analysis.c
	SRC += src/thirdparty/libvorbis/lib/synthesis.c
	SRC += src/thirdparty/libvorbis/lib/psy.c
